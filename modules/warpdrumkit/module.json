{
  "id": "warpdrumkit",
  "name": "Drum Kit+",
  "abbrev": "DK+",
  "version": "0.1.2",
  "description": "Move Drum Kit-style shell with an extra per-pad Warp bank",
  "author": "douglasmason",
  "license": "MIT",
  "dsp": "dsp.so",
  "api_version": 2,
  "defaults": {
    "current_pad": 1,
    "polyphony": 16,
    "auto_root": "on",
    "default_root": 60,
    "slice_analyze": "on",
    "slice_count": 8,
    "pitched_mode": "off"
  },
  "capabilities": {
    "audio_out": true,
    "audio_in": true,
    "midi_in": true,
    "midi_out": false,
    "chainable": true,
    "component_type": "sound_generator",
    "ui_hierarchy": {
      "levels": {
        "root": {
          "name": "Drum Kit+",
          "params": [{"label":"Pad","level":"pad"},{"label":"Warp","level":"warp"},{"label":"Capture/Slice","level":"capture"}],
          "knobs": ["current_pad","pad_vol","pad_pan","pad_tune","pad_trim_start","pad_attack_ms","pad_decay_ms","pad_warp"]
        },
        "pad": {
          "name": "Pad",
          "params": ["current_pad","pad_vol","pad_pan","pad_tune","pad_trim_start","pad_trim_end","pad_attack_ms","pad_decay_ms","pad_choke_group","pad_mode","pad_chance_pct"],
          "knobs": ["pad_vol","pad_pan","pad_tune","pad_trim_start","pad_trim_end","pad_attack_ms","pad_decay_ms","pad_choke_group"]
        },
        "warp": {
          "name": "Warp",
          "params": ["pad_warp","pad_length_pct","pad_length_ms","pad_grain_ms","pad_root_note","pitched_mode"],
          "knobs": ["pad_warp","pad_length_pct","pad_length_ms","pad_grain_ms","pad_root_note","pitched_mode"]
        },
        "capture": {
          "name": "Capture / Slice",
          "params": ["record","auto_root","default_root","slice_count","slice_analyze","slice"],
          "knobs": ["record","auto_root","default_root","slice_count","slice_analyze","slice"]
        }
      }
    }
  }
}
